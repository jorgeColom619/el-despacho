			{"t": "Algo intermedio y discreto.", "fx": {"money": -20, "estabilidad": 1}},
		], "default": 2},
	{"id": "v3_ciberataque_ministerio", "type": "advisor", "who": "interior", "title": "Secuestro digital",
		"text": "Presidente, un grupo de hackers ha cifrado todos los ordenadores del Ministerio de Trabajo. Piden 20 millones en criptomonedas. Sin esos ordenadores, este mes no se pueden pagar las prestaciones por desempleo.",
		"cond": {"min_day": 60}, "once": true, "urgent": 25.0, "w": 0.8,
		"choices": [
