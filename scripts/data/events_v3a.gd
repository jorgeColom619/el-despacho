		], "default": 2},
	{"id": "v3_auditoria_union", "type": "advisor", "who": "exteriores", "title": "La Unión revisa nuestros fondos",
		"text": "Presidente, los auditores de la Unión dicen que hemos gastado 400 millones de fondos europeos en obras que no cumplían los requisitos. Exigen la devolución. Podemos pagar, recurrir o negociar con Vaelsen.",
		"cond": {"min_day": 100}, "once": true, "w": 0.7,
