; Engine configuration file.
; El Despacho - Simulador presidencial

config_version=5

[application]

config/name="El Despacho"
config/description="Simulador presidencial: gobierna, negocia y sobrevive a la legislatura."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.05, 0.09, 1)
boot_splash/show_image=false

[autoload]

UI="*res://scripts/autoload/ui.gd"
Sfx="*res://scripts/autoload/sfx.gd"
DB="*res://scripts/autoload/db.gd"
GS="*res://scripts/autoload/game_state.gd"
Payments="*res://scripts/autoload/payments.gd"
Perfil="*res://scripts/autoload/profile.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

rendering_device/fallback_to_opengl3=true
lights_and_shadows/positional_shadow/atlas_size=4096
anti_aliasing/quality/msaa_3d=2

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.09, 1)
